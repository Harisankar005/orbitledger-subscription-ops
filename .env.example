# OrbitLedger Environment Configuration
# Set ENVIRONMENT to 'development', 'production', or 'test'
ENVIRONMENT=development

# Secret Key used for signing JWTs and session tokens.
# IN PRODUCTION: Strictly required, at least 32 characters, cryptographically random, not a placeholder.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, leave blank or unset to use the local development default.
SECRET_KEY=

# Database URL: PostgreSQL (production) or SQLite (development/fallback)
DATABASE_URL=sqlite:///./brightloop.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+psycopg://brightloop:brightloop@db:5432/brightloop

# Token expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=Asia/Kolkata

# Worker and demo controls
EMBEDDED_WORKER=true
# DEMO_MODE enables simulated clock advancement (+1 month).
# In production, it is strictly disabled (false) unless ALLOW_PRODUCTION_DEMO_OVERRIDE=true is set.
DEMO_MODE=true
ALLOW_PRODUCTION_DEMO_OVERRIDE=false

# Cookie Security (Secure, HttpOnly, SameSite=Strict)
# In production, cookies are strictly enforced as Secure=True and SameSite=Strict.
# For local HTTP development, SECURE_COOKIES defaults to false.
SECURE_COOKIES=false
COOKIE_SAMESITE=strict

# SMTP Outbox / Mailpit local inbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=billing@brightloop.test
SMTP_TLS=false
