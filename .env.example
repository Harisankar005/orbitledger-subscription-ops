# Brightloop Environment Configuration
# Set ENVIRONMENT to 'development', 'production', or 'test'
ENVIRONMENT=development

# Secret Key used for signing JWTs and session tokens.
# IN PRODUCTION: Must be at least 32 characters, cryptographically random, and not a placeholder.
# Generate via: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-secure-random-32-plus-character-secret-key-in-production

# Database URL: PostgreSQL (production) or SQLite (development/fallback)
DATABASE_URL=sqlite:///./brightloop.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+psycopg://brightloop:brightloop@db:5432/brightloop

# Token expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=Asia/Kolkata

# Worker and demo controls
EMBEDDED_WORKER=true
# DEMO_MODE enables simulated clock advancement. In production, it defaults to false!
DEMO_MODE=true

# Cookie Security (Secure, HttpOnly, SameSite=Strict)
# In production, cookies are automatically set to Secure=True. For local HTTP testing:
# SECURE_COOKIES=false

# SMTP Outbox / Mailpit local inbox
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=billing@brightloop.test
SMTP_TLS=false
