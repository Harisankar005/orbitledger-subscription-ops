# Brightloop Environment Configuration
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production-brightloop-32chars
DATABASE_URL=sqlite:///./brightloop.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+psycopg://brightloop:brightloop@db:5432/brightloop

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TIMEZONE=Asia/Kolkata
EMBEDDED_WORKER=true
DEMO_MODE=true

# SMTP Outbox / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=billing@brightloop.test
SMTP_TLS=false
